<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HeavyLift.Views.WorkoutViews.ExerciseSelectView"
             xmlns:viewmodel="clr-namespace:HeavyLift.ViewModels.WorkoutViewModels"
             xmlns:model="clr-namespace:HeavyLift.Models"
             xmlns:constants="clr-namespace:HeavyLift.Models.Constants"
             xmlns:customcontrols="clr-namespace:HeavyLift.CustomControls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="viewmodel:ExerciseSelectViewModel"
             Title="Select exercise">
    <Shell.TabBarIsVisible>False</Shell.TabBarIsVisible>
    <Grid x:Name="ExerciseSelectViewGrid"
        BackgroundColor="{StaticResource BackgroundColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <VerticalStackLayout Margin="20" Spacing="20">
            <Label Style="{StaticResource Big}" Text="Search" />
            <Border Padding="5"
                    Stroke="{StaticResource Secondary}" StrokeShape="RoundRectangle 30" StrokeThickness="4"
                    Background="{StaticResource SecondaryBackgroundColor}">
                    <Entry Placeholder="Exercise name" PlaceholderColor="{StaticResource TextColor}"
                         TextColor="{StaticResource TextColor}" FontSize="16"
                    />
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource MainButton}"  Text="Add custom exercise" LineBreakMode="WordWrap"
                        Command="{Binding TestCommand}"/>

                <Button Grid.Column="2" Style="{StaticResource MainButton}" 
                        Text="Muscles"
                        Command="{Binding OpenSelectMuscleGroupMenuCommand}"/>
            </Grid>
        </VerticalStackLayout>
        <ScrollView Grid.Row="1" Margin="20,0,20,20">
            <VerticalStackLayout Spacing="10">
                <CollectionView ItemsSource="{Binding DisplayedExercisesList}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="model:ExerciseModel">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="74"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        NumberOfTapsRequired="2"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:ExerciseSelectViewModel}}, Path=AddExerciseToPlanCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Grid.GestureRecognizers>
                                <Border
                                    HeightRequest="64" WidthRequest="64" Margin="0,0,10,0"
                                    StrokeShape="RoundRectangle 32" StrokeThickness="0"
                                    Background="{StaticResource White}">
                                    <Image Source="no_picture.png" 
                                        HeightRequest="64" WidthRequest="64"
                                        Aspect="AspectFit"/>
                                    
                                </Border>
                                <Label Grid.Column="1" Style="{StaticResource Big}" Text="{Binding name}" 
                                       HeightRequest="64" VerticalTextAlignment="Center"/>
                                <Button Grid.Column="2" Text="Add" Style="{StaticResource MainButtonSmall}" HeightRequest="30" WidthRequest="70"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:ExerciseSelectViewModel}}, Path=AddExerciseToPlanCommand}"
                                        CommandParameter="{Binding .}"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
        
        <!-- muscle group selector !-->
        <Grid Grid.RowSpan="2" VerticalOptions="End"  IsVisible="{Binding SelectMuscleGroupsVisible}"
              >
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="320"/>
            </Grid.RowDefinitions>
            <Button Grid.Column="0" HeightRequest="500" Margin="-15, 0" Background="Transparent" Command="{Binding CloseSelectMuscleGroupMenuCommand}"/>
            <Border  Grid.Row="1"
                Background="{StaticResource BackgroundColor}"
                StrokeThickness="4" StrokeShape="RoundRectangle 30,30,0,0" Stroke="{StaticResource PrimaryColor}"
                Margin="-20,0,-20, -5"  Padding="15"
                VerticalOptions="End" 
                HeightRequest="400"
                >
                <ScrollView Margin="20,5">
                    <CollectionView ItemsSource="{Binding MuscleGroupsDisplay}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <customcontrols:MainRadioButton x:Name="MuscleGroupSelect"
                                                                Margin="0,10" 
                                                                GroupName="MuscleSelector"
                                                                Content="{Binding .}"
                                                                Value="{Binding .}">
                                    
                                    <customcontrols:MainRadioButton.Behaviors>
                                        <toolkit:EventToCommandBehavior
                                            EventName="CheckedChanged"
                                            Command="{Binding BindingContext.SelectMuscleGroupFilterCommand, Source={x:Reference ExerciseSelectViewGrid}}"
                                            CommandParameter="{Binding BindingContext, Source={x:Reference MuscleGroupSelect}}"/>
                                    </customcontrols:MainRadioButton.Behaviors>
                                    
                                </customcontrols:MainRadioButton>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </ScrollView>
            </Border>
        </Grid>
        
     </Grid>
</ContentPage>