<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HeavyLift.Views.WorkoutViews.ExerciseSelectView"
             xmlns:viewmodel="clr-namespace:HeavyLift.ViewModels.WorkoutViewModels"
             xmlns:model="clr-namespace:HeavyLift.Models" 
             x:DataType="viewmodel:ExerciseSelectViewModel"
             Title="Select exercise">
    <Grid BackgroundColor="{StaticResource BackgroundColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <VerticalStackLayout Margin="20" Spacing="20">
            <Label Style="{StaticResource Big}" Text="Search"/>
            <Border Padding="5"
                    Stroke="{StaticResource Secondary}" StrokeShape="RoundRectangle 30" StrokeThickness="4"
                    Background="{StaticResource SecondaryBackgroundColor}">
                    <Entry Placeholder="Exercise name" PlaceholderColor="{StaticResource TextColor}"
                         TextColor="{StaticResource TextColor}" FontSize="16"
                    />
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource MainButton}"  Text="Add custom exercise" LineBreakMode="WordWrap"
                        Command="{Binding TestCommand}"/>

                <Button Grid.Column="2" Style="{StaticResource MainButton}" 
                        Text="Muscles"/>
            </Grid>
        </VerticalStackLayout>
        <ScrollView Grid.Row="1" Margin="20,0,20,20">
            <VerticalStackLayout Spacing="10">
                <CollectionView ItemsSource="{Binding Exercises}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="model:ExerciseModel">
                            <Border Padding="10"
                                    Stroke="{StaticResource Secondary}" StrokeShape="RoundRectangle 30" StrokeThickness="4"
                                    Background="{StaticResource SecondaryBackgroundColor}">
                                <Label Text="{Binding Name}" TextColor="{StaticResource TextColor}" FontSize="16"/>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>